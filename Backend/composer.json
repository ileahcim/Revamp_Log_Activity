{
    "name": "elnusa/log-activity-api",
    "description": "REST API Log Activity - PT Elnusa Warehouse BSD",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "^7.1",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public public/index.php",
        "lint": "find public routes src -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}

# ===========================================================================
#  Log Activity API
#  Semua request diarahkan ke index.php.
# ===========================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sebagian shared hosting menjalankan PHP sebagai CGI/FastCGI dan membuang
    # header Authorization sebelum sampai ke PHP. Dua baris ini meneruskannya
    # kembali. Tanpa ini, semua request akan dijawab 401 walau tokennya benar.
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # File dan folder yang benar-benar ada tetap dilayani apa adanya,
    # selebihnya masuk ke index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Cadangan untuk server yang tidak memakai mod_rewrite.
<IfModule !mod_rewrite.c>
    <IfModule mod_setenvif.c>
        SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    </IfModule>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# Jangan pernah menampilkan daftar isi folder.
Options -Indexes

# Isi aplikasi duduk di dalam api/app/ pada susunan shared hosting. Penjaga
# utamanya .htaccess di dalam folder app/ itu sendiri, yang tersedia siap pakai
# di Backend/deploy/app/.htaccess. Baris di bawah adalah lapis luarnya: dia yang
# menutup celah kalau berkas tersebut lupa terunggah -- berkas berawalan titik
# gampang tak terlihat di FileZilla, dan kelalaian sekecil itu cukup untuk
# menyajikan .env berikut password database kepada siapa pun yang menebak
# alamatnya.
#
# 404, bukan 403: tidak perlu memberi tahu orang luar bahwa folder yang mereka
# tebak memang ada. Tidak ada route Slim yang berbentuk /api/app, jadi tidak ada
# yang bisa terganggu.
<IfModule mod_alias.c>
    RedirectMatch 404 (?i)/api/app(/|$)
</IfModule>

# Berkas yang tidak pernah boleh terbaca lewat browser, walaupun secara tidak
# sengaja tersalin ke folder ini atau ke bawahnya:
#
#   .env, composer.*   konfigurasi dan susunan dependensi
#   *.sql              seluruh struktur tabel (01_schema.sql dan kawan-kawan)
#   *.md               README ini memuat contoh nilai dan letak berkas di server
#   *.json, *.log      isi storage/: antrean pendaftaran, NIK, pesan error asli
#
# <FilesMatch> di .htaccess berlaku untuk folder ini dan seluruh isinya, jadi
# satu aturan di sini ikut menjaga app/storage/ juga. API sendiri tidak
# terpengaruh -- JSON-nya disusun PHP, bukan dibaca dari berkas .json.
<FilesMatch "(?i)^\.env|^composer\.(json|lock)$|\.(sql|md|json|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

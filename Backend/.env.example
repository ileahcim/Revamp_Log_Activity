# ===========================================================================
#  Log Activity API - contoh konfigurasi
#  Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit file .env.
# ===========================================================================

# --- Aplikasi --------------------------------------------------------------
# development | production
APP_ENV=development

# true = detail error ikut dikirim di response. WAJIB false di production.
APP_DEBUG=true

APP_TIMEZONE=Asia/Jakarta

# Bagian alamat DI DEPAN "/api". Kosongkan kalau backend ada tepat di
# https://domain.com/api. Isi kalau aplikasinya duduk di subfolder:
#
#   https://domain.com/log_activity/api/health  ->  APP_BASE_PATH=/log_activity
#
# Garis miring di depan, tidak di belakang. Salah di sini membuat semua
# endpoint dijawab 404 berbentuk JSON, padahal berkasnya sudah benar semua.
APP_BASE_PATH=

# --- Database (MariaDB Hostinger) ------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Zona waktu sesi MySQL. Pakai offset numerik, bukan nama seperti
# "Asia/Jakarta" -- shared hosting jarang memuat tabel zona waktu MySQL.
DB_TIME_ZONE=+07:00

# --- Firebase Authentication ------------------------------------------------
# Backend memverifikasi ID token yang dikirim frontend ke public key Google.
# Nilai ini harus sama persis dengan projectId di
# Frontend/firebase-applet-config.json, kalau tidak semua token akan ditolak.
FIREBASE_PROJECT_ID=gen-lang-client-0722752672

# --- Hak akses --------------------------------------------------------------
# Super admin. Boleh lebih dari satu, dipisah koma.
#
# Alamat di sini adalah AKAR: otomatis jadi admin setiap kali login, bisa
# mendaftar tanpa melewati dua lapis pembatasan di bawah, dan TIDAK BISA
# diturunkan lewat aplikasi. Itu jaring pengaman terakhir -- kalau berkas
# storage/super-admins.json rusak atau semua super admin salah diturunkan,
# alamat di sini tetap bisa masuk.
#
# Super admin tambahan bisa diangkat lewat AdminPanel tanpa menyentuh berkas
# ini; yang itu tersimpan di storage/super-admins.json dan bisa diturunkan lagi.
# Baca bagian "Serah Terima" di README sebelum super admin lama pergi.
SUPER_ADMIN_EMAILS=leahcimtwis@gmail.com

# Nama lama, bentuk tunggal. Masih dibaca dan diperlakukan sama seperti baris di
# atas, jadi .env lama tetap jalan tanpa disunting. Untuk pemasangan baru, pakai
# SUPER_ADMIN_EMAILS saja.
#SUPER_ADMIN_EMAIL=

# User penampung untuk log lama yang NIK/nama-nya tidak ketemu saat migrasi.
# Baris ini dibuat oleh 04_legacy_user.sql.
LEGACY_USER_ID=legacy-unknown

# NIK milik akun penampung itu. Dilarang dipakai mendaftar.
LEGACY_NIK=LEGACY-000

# --- Pembatasan pendaftaran -------------------------------------------------
# Dua lapis, masing-masing bisa dimatikan sendiri. Keduanya menyala kalau
# barisnya dihapus atau dikosongkan -- default-nya sengaja yang paling ketat.
#
# Ini juga jalan keluar darurat: kalau suatu saat aturannya mengunci orang yang
# seharusnya bisa masuk, ubah satu baris di sini, tanpa menyentuh kode atau
# database.

# Lapis 1: NIK yang diisi saat mendaftar harus sudah dikenal sistem, yaitu ada
# di tech_logs.nik_snapshot (teknisi lama) atau di daftar izin yang dikelola
# admin lewat AdminPanel.
#
# Mematikannya TIDAK mematikan pemeriksaan NIK kembar; yang hilang hanya syarat
# "harus sudah dikenal".
REGISTRATION_REQUIRE_KNOWN_NIK=true

# Lapis 2: pendaftaran yang lolos Lapis 1 masuk antrean dan baru aktif setelah
# admin menyetujuinya di AdminPanel. Selama menunggu, orangnya tidak punya baris
# di tabel users sama sekali, jadi tidak bisa membuka apa pun selain status
# dirinya sendiri.
REGISTRATION_REQUIRE_APPROVAL=true

# --- CORS -------------------------------------------------------------------
# Saat development frontend jalan di port lain (Vite), jadi CORS perlu aktif.
# Saat production frontend dan backend satu domain -> set false.
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Batas request ----------------------------------------------------------
# Jumlah baris maksimum yang boleh diminta sekali panggil.
API_MAX_LIMIT=500
API_DEFAULT_LIMIT=100

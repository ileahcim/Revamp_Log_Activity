# ===========================================================================
#  Log Activity API - konfigurasi PRODUCTION (Hostinger)
#
#  Cara pakai: salin berkas ini jadi ".env", isi bagian database, lalu unggah
#  ke server sebagai:
#
#      public_html/log_activity/api/app/.env
#
#  Berkas ini adalah contoh, isinya aman ikut ke git. Berkas .env hasil
#  salinannya TIDAK -- di dalamnya ada password database.
#
#  Nilai di sini sudah disetel untuk pemasangan di arpgrs.com/log_activity.
#  Penjelasan panjang tiap baris ada di .env.example; yang di bawah hanya
#  yang berbeda atau yang gampang salah. Langkah lengkapnya di DEPLOY.md.
# ===========================================================================

# --- Aplikasi --------------------------------------------------------------
APP_ENV=production

# WAJIB false. Kalau true, pesan error PHP -- lengkap dengan potongan query
# dan letak berkas di server -- ikut terkirim ke browser siapa pun yang
# memancingnya. Detailnya tetap tercatat di storage/logs/, tempatnya memang
# di situ.
APP_DEBUG=false

APP_TIMEZONE=Asia/Jakarta

# Bagian alamat di depan "/api", karena aplikasi ini tidak dipasang di akar
# domain melainkan di subfolder:
#
#     https://arpgrs.com/log_activity/api/health
#                       ^^^^^^^^^^^^^
#
# Slim mencocokkan route mulai dari "/api/...", jadi tanpa baris ini seluruh
# endpoint dijawab 404 padahal berkasnya sudah benar semua. Tulis dengan garis
# miring di depan, tanpa garis miring di belakang, dan tanpa "/api".
APP_BASE_PATH=/log_activity

# --- Database (MariaDB Hostinger) ------------------------------------------
# Dari dalam server, database berada di mesin yang sama: pakai localhost.
# Alamat IP yang dipakai saat migrasi dari komputer sendiri (153.92.15.7)
# hanya diperlukan dari luar, lewat Remote MySQL, dan lebih lambat.
DB_HOST=localhost
DB_PORT=3306

# Ambil dari hPanel -> Databases -> Management. Nama database dan user di
# Hostinger selalu berawalan nomor akun, contoh u123456789_logactivity.
DB_NAME=
DB_USER=
DB_PASSWORD=

DB_CHARSET=utf8mb4

# Offset numerik, bukan "Asia/Jakarta" -- shared hosting jarang memuat tabel
# zona waktu MySQL, dan namanya akan ditolak diam-diam.
DB_TIME_ZONE=+07:00

# --- Firebase Authentication ------------------------------------------------
# Harus sama persis dengan projectId di Frontend/firebase-applet-config.json,
# kalau tidak semua token ditolak dengan pesan "Token ini bukan untuk aplikasi
# ini".
FIREBASE_PROJECT_ID=gen-lang-client-0722752672

# --- Hak akses --------------------------------------------------------------
# Jaring pengaman terakhir: alamat di sini otomatis jadi admin setiap kali
# login dan tidak bisa diturunkan lewat aplikasi. Boleh lebih dari satu,
# dipisah koma. Baca bagian "Serah Terima" di README sebelum mengubahnya.
SUPER_ADMIN_EMAILS=leahcimtwis@gmail.com

# Akun penampung log lama yang tidak teridentifikasi saat migrasi. Dibuat oleh
# 04_legacy_user.sql, sudah ada di database production.
LEGACY_USER_ID=legacy-unknown
LEGACY_NIK=LEGACY-000

# --- Pembatasan pendaftaran -------------------------------------------------
# Keduanya menyala. Lapis 1: NIK harus sudah dikenal sistem. Lapis 2:
# pendaftaran menunggu persetujuan admin. Ini juga jalan keluar darurat --
# kalau suatu saat aturannya mengunci orang yang seharusnya bisa masuk, ubah
# satu baris di sini, tanpa menyentuh kode atau database.
REGISTRATION_REQUIRE_KNOWN_NIK=true
REGISTRATION_REQUIRE_APPROVAL=true

# --- CORS -------------------------------------------------------------------
# Mati, karena frontend dan backend satu domain: halaman di
# arpgrs.com/log_activity memanggil arpgrs.com/log_activity/api, jadi browser
# tidak pernah menganggapnya lintas domain dan tidak ada izin yang perlu
# diberikan.
#
# Menyalakannya berarti membuka API ini untuk halaman di domain lain. Jangan,
# kecuali frontend memang dipindah ke domain terpisah -- dan kalau itu terjadi,
# daftarkan domainnya satu per satu di bawah, jangan pakai "*".
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=

# --- Batas request ----------------------------------------------------------
API_MAX_LIMIT=500
API_DEFAULT_LIMIT=100

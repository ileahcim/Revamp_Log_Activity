# =============================================================
#  Migration Tool - Log Activity
#  Copy file ini menjadi ".env" lalu isi nilainya.
#  JANGAN commit file .env ke git.
# =============================================================

# --- MariaDB Hostinger -----------------------------------------------------
# Ambil dari hPanel > Databases > Management.
# Untuk konek dari laptop, IP kamu harus didaftarkan dulu di
# hPanel > Databases > Remote MySQL (bisa juga "Any Host" / % sementara).
DB_HOST=srvXXX.hstgr.io
DB_PORT=3306
DB_NAME=uXXXXXXXX_logactivity
DB_USER=uXXXXXXXX_admin
DB_PASSWORD=

# Set true kalau host mewajibkan TLS. Default false (Hostinger umumnya false).
DB_SSL=false

# --- Firebase --------------------------------------------------------------
# Path service account JSON (Firebase Console > Project Settings >
# Service accounts > Generate new private key).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/serviceAccountKey.json

# PENTING: project ini TIDAK memakai database "(default)".
# Nilai di bawah diambil dari Frontend/firebase-applet-config.json
# -> field "firestoreDatabaseId".
# Kalau salah/kosong, Firestore akan terbaca 0 dokumen.
FIRESTORE_DATABASE_ID=ai-studio-1df37006-f2a0-4aa1-9a90-914acfac7130

# --- Perilaku migrasi ------------------------------------------------------
# Jumlah dokumen yang dibaca & di-insert per batch.
BATCH_SIZE=500

# Batch khusus tech_bug_reports (isinya base64 image, jadi harus kecil).
BUG_REPORT_BATCH_SIZE=10

# insert  = INSERT biasa (gagal kalau id sudah ada)
# ignore  = INSERT IGNORE (lewati yang sudah ada)
# upsert  = INSERT ... ON DUPLICATE KEY UPDATE (aman diulang-ulang)  <-- default
WRITE_MODE=upsert

# Offset timezone untuk mengubah created_at/timestamp (ISO UTC dari Firestore)
# menjadi DATETIME MariaDB.
#   420 = WIB (UTC+7)  <-- default, supaya jam di DB sama dengan yang dilihat user
#   0   = simpan apa adanya dalam UTC
TZ_OFFSET_MINUTES=420

# Akun penampung untuk data lama yang tidak ketemu pemiliknya.
# tech_logs.user_id, audit_logs.user_id, dan tech_bug_reports.user_id semuanya
# NOT NULL dengan FK ke users, jadi baris yang tidak teridentifikasi harus
# bersandar ke satu akun. Barisnya dibuat oleh Backend/04_legacy_user.sql.
# Nilai ini harus sama dengan LEGACY_USER_ID di Backend/.env.
LEGACY_USER_ID=legacy-unknown

# Rapikan nama technician & supervisor saat migrasi
# ("  pak  BUDI santoso " -> "Budi Santoso").
# Ini meniru normalizeName() yang sekarang dipakai frontend saat menampilkan data.
NORMALIZE_NAMES=true

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: alamat backend Slim (folder Backend/).
#
# Wajib berawalan VITE_ -- hanya variabel dengan awalan itu yang diteruskan
# Vite ke kode browser lewat import.meta.env. Tanpa awalan itu nilainya
# undefined saat dijalankan, bukan error saat build, jadi gampang terlewat.
#
# Jangan pakai "/api" di belakang; kode frontend yang menambahkannya.
#   development : http://localhost:8080
#   production  : https://domain-anda.com   (backend di /api pada domain sama)
#
# Salin nilainya ke .env.local -- berkas itu tidak ikut ke git.
VITE_API_URL="http://localhost:8080"
